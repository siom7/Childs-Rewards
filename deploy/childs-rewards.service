[Unit]
Description=Points Famille (Childs-Rewards)
After=network.target

[Service]
User=childs-rewards
Group=childs-rewards
WorkingDirectory=/opt/childs-rewards
Environment=CR_DATA_DIR=/var/lib/childs-rewards
# Cookie de session « Secure » automatiquement dès que l'accès se fait en HTTPS (via le reverse proxy)
Environment=CR_COOKIE_SECURE=auto
Environment=CR_TIMEZONE=Europe/Paris
# --proxy-headers : récupère la vraie IP du visiteur (limitation des tentatives de connexion).
# Si le reverse proxy est sur une autre machine, remplacer 127.0.0.1 par son adresse IP.
ExecStart=/opt/childs-rewards/.venv/bin/uvicorn app.main:app --host @BIND@ --port @PORT@ \
          --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure

# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/childs-rewards

[Install]
WantedBy=multi-user.target
